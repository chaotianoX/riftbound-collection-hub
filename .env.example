# Local Supabase only. Copy the URL/public key from `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key
# No service role key is needed by the web application.

# Administrative CLI only; keep this out of the Vercel/Next.js environment.
# Remote DB connections must verify TLS. Never use a NEXT_PUBLIC_ variable.
# CATALOG_DATABASE_URL=postgresql://catalog_admin:REPLACE_ME@db.example.invalid:5432/postgres?sslmode=verify-full
